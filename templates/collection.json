      "type": "dlh-faq",
      "blocks": {
        "faq_first": {
          "type": "faq_item",
          "settings": {
            "question": "Which experience should I pick for a first visit?",
            "answer": "Start with the Sunset Desert Safari. In one evening you get the dune bashing, the sunset, sandboarding, a camel ride, a BBQ dinner and the live shows, with hotel pickup and drop-off included."
          }
        },
        "faq_addons": {
          "type": "faq_item",
          "settings": {
            "question": "Can I add a quad bike or a dune buggy to my safari?",
            "answer": "Yes. Quad bike and dune buggy rides are optional extras on the Sunset Desert Safari. You can also book them on their own, from 30 minutes."
          }
        },
        "faq_private": {
          "type": "faq_item",
          "settings": {
            "question": "Which experiences are private?",
            "answer": "The Sunrise and Morning Desert Safaris run in a private 4x4 for up to 6 guests. The camel ride is a private ride for up to 2 guests per camel, and the Flying Dress Photoshoot is booked for you alone, as a duo or as a group."
          }
        },
        "faq_kids": {
          "type": "faq_item",
          "settings": {
            "question": "Is the desert safari safe for kids and seniors?",
            "answer": "Yes. We host guests from age 3 to 80+. Dune bashing is optional — families with young children or seniors can skip it and join us directly at the camp. Every vehicle has seatbelts, a trained driver, and first-aid equipment."
          }
        },
        "faq_wear": {
          "type": "faq_item",
          "settings": {
            "question": "What should I wear?",
            "answer": "Loose, comfortable clothing and closed-toe shoes for daytime. Light layers for evening — the desert cools sharply after sunset. Cultural dress (shoulders and knees covered) is recommended for the camp."
          }
        },
        "faq_cancel": {
          "type": "faq_item",
          "settings": {
            "question": "What is your cancellation policy?",
            "answer": "Free cancellation up to 24 hours before your experience. No-questions-asked refund to your original payment method within 3 business days."
          }
        }
