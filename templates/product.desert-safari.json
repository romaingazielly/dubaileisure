        "know_1": {
          "type": "know",
          "settings": {
            "title": "What to wear",
            "text": "<p>Loose, comfortable clothes and closed shoes. Bring a light layer: the desert gets cooler after sunset. Covered shoulders and knees are recommended at the camp.</p>"
          }
        },
        "know_2": {
          "type": "know",
          "settings": {
            "title": "Children and seniors",
            "text": "<p>We welcome guests from age 3 to 80+. Dune bashing is optional: you can skip it and join us directly at the camp.</p>"
          }
        },
        "know_3": {
          "type": "know",
          "settings": {
            "title": "Health and safety",
            "text": "<p>Dune bashing is a bumpy ride. It is not recommended for pregnant guests or guests with back, neck or heart problems. Every vehicle has seatbelts, a trained driver and a first-aid kit.</p>"
          }
        },
        "know_4": {
          "type": "know",
          "settings": {
            "title": "Food and allergies",
            "text": "<p>The BBQ buffet includes halal meats, vegetarian and vegan dishes and gluten-free mains. Tell us about any allergy when you book.</p>"
          }
        }
      },
