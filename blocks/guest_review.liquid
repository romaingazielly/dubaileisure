{% render 'guest-review-card', block: block, show_shopify_attributes: true %}

{% schema %}
{
  "name": "Guest review",
  "tag": null,
  "settings": [
    {
      "type": "range",
      "id": "rating",
      "min": 1,
      "max": 5,
      "step": 1,
      "label": "Rating",
      "default": 5
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Review",
      "default": "Absolutely spectacular evening. The dune bashing was thrilling, the buffet was outstanding, and the fire show had our kids speechless."
    },
    {
      "type": "text",
      "id": "author",
      "label": "Name",
      "default": "James M."
    },
    {
      "type": "select",
      "id": "source",
      "label": "Source",
      "options": [
        { "value": "tripadvisor", "label": "TripAdvisor" },
        { "value": "google", "label": "Google" },
        { "value": "getyourguide", "label": "GetYourGuide" },
        { "value": "none", "label": "None" }
      ],
      "default": "tripadvisor"
    },
    {
      "type": "text",
      "id": "meta",
      "label": "Location",
      "info": "e.g. London, UK",
      "default": "London, UK"
    }
  ],
  "presets": [
    {
      "name": "Guest review",
      "category": "t:categories.storytelling",
      "settings": {
        "quote": "Absolutely spectacular evening. The dune bashing was thrilling, the buffet was outstanding, and the fire show had our kids speechless.",
        "author": "James M.",
        "meta": "London, UK",
        "source": "tripadvisor"
      }
    }
  ]
}
{% endschema %}
