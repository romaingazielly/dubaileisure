

{% capture submit_button %}
  {% content_for 'block', type: 'contact-form-submit-button', id: 'submit-button' %}
{% endcapture %}

<div
  class="
    contact-form
    spacing-style size-style
    {% if block.settings.inherit_color_scheme == false %}color-{{ block.settings.color_scheme }}{% endif %}
  "
  style="
    {% render 'spacing-style', settings: block.settings %}
    {% render 'size-style', settings: block.settings %}
  "
  {{ block.shopify_attributes }}
>
  {% assign form_id = block.id | default: section.id | prepend: 'ContactForm-' %}
  {%- form 'contact', id: form_id, class: 'contact-form__form' -%}
    <input
      name="contact[id]"
      type="hidden"
      value="{{ form_id }}"
    >

    {%- if block.settings.form_header != blank or block.settings.form_intro != blank -%}
      <div class="contact-form__header">
        {%- if block.settings.form_header != blank -%}
          <h2 class="contact-form__title">{{ block.settings.form_header }}</h2>
        {%- endif -%}
        {%- if block.settings.form_intro != blank -%}
          <p class="contact-form__intro">{{ block.settings.form_intro }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if form.errors and form.id == form_id -%}
      <div
        class="contact-form__error"
        tabindex="-1"
        autofocus
      >
        {{- 'icon-error.svg' | inline_asset_content -}}

        {{- form.errors.translated_fields.email | capitalize }}
        {{ form.errors.messages.email -}}
      </div>
    {%- endif -%}

    {%- if form.posted_successfully? and form.id == form_id -%}
      <div
        class="contact-form__success"
        tabindex="-1"
        autofocus
      >
        {{- 'icon-checkmark.svg' | inline_asset_content -}}
        {{- 'blocks.contact_form.post_success' | t -}}
      </div>
    {%- endif -%}

    <div class="contact-form__form-row">
      <label
        class="visually-hidden"
        for="ContactForm-name"
      >
        {{- 'blocks.contact_form.name' | t -}}
      </label>
      <input
        type="text"
        id="ContactForm-name"
        class="contact-form__input"
        autocomplete="name"
        name="contact[name]"
        value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
        placeholder="{{ 'blocks.contact_form.name' | t }}"
      >

      <label
        class="visually-hidden"
        for="ContactForm-email"
      >
        {{- 'blocks.contact_form.email' | t -}}
        <span aria-hidden="true">*</span></label
      >
      <input
        type="email"
        id="ContactForm-email"
        class="contact-form__input"
        autocomplete="email"
        name="contact[email]"
        spellcheck="false"
        autocapitalize="off"
        value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
        aria-required="true"
        {% if form.errors contains 'email' and form.id == form_id %}
          aria-invalid="true"
          aria-describedby="ContactForm-email-error"
        {% endif %}
        placeholder="{{ 'blocks.contact_form.email' | t }}"
      >
    </div>

    <label
      class="visually-hidden"
      for="ContactForm-phone"
    >
      {{- 'blocks.contact_form.phone' | t -}}
    </label>
    <input
      type="tel"
      id="ContactForm-phone"
      class="contact-form__input"
      autocomplete="tel"
      name="contact[phone]"
      pattern="[0-9\-]*"
      value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
      placeholder="{{ 'blocks.contact_form.phone' | t }}"
    >

    <label
      class="visually-hidden"
      for="ContactForm-body"
    >
      {{- 'blocks.contact_form.comment' | t -}}
    </label>
    <div class="contact-form__compose">
      <textarea
        rows="8"
        id="ContactForm-body"
        class="contact-form__input contact-form__input--textarea"
        name="contact[body]"
        placeholder="{{ 'blocks.contact_form.comment' | t }}"
      >
        {{- form.body -}}
      </textarea>

      <div class="contact-form__actions">
        {%- if block.settings.trust_microcopy != blank -%}
          <span class="contact-form__trust">{{ block.settings.trust_microcopy }}</span>
        {%- endif -%}
        {{ submit_button }}
      </div>
    </div>
  {%- endform -%}
</div>

{% stylesheet %}
  .contact-form__form {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
  }

  .contact-form__header {
    margin-bottom: var(--gap-sm);
  }

  .contact-form__title {
    font-family: var(--font-primary--family, inherit);
    font-size: clamp(20px, 2.1vw, 26px);
    line-height: 1.2;
    font-weight: 600;
    margin: 0 0 6px;
    letter-spacing: -0.01em;
  }

  .contact-form__intro {
    font-size: 14.5px;
    line-height: 1.5;
    opacity: 0.72;
    margin: 0;
  }

  .contact-form__form-row {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);

    @media screen and (min-width: 750px) {
      flex-direction: row;
      align-items: center;
    }
  }

  .contact-form__input {
    width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--color-input-text);
    background-color: var(--color-input-background);
    padding: var(--padding-lg) var(--padding-xl);
    border-radius: var(--style-border-radius-inputs);
    border: var(--style-border-width-inputs) solid var(--color-input-border);
    -webkit-font-smoothing: antialiased;
    transition: border-color 0.18s ease, box-shadow 0.18s ease, background-color 0.18s ease;
  }

  .contact-form__input:hover {
    border-color: color-mix(in srgb, var(--brand-red, #b11c3d) 35%, var(--color-input-border));
  }

  .contact-form__input:focus,
  .contact-form__input:focus-visible {
    border-color: var(--brand-red, #b11c3d);
    outline: 3px solid color-mix(in srgb, var(--brand-red, #b11c3d) 18%, transparent);
    outline-offset: 0;
  }

  .contact-form__input--textarea {
    resize: vertical;
    min-height: var(--input-textarea-min-height);
  }

  /* Compose box: wraps textarea + actions in one bordered container */
  .contact-form__compose {
    position: relative;
    display: flex;
    flex-direction: column;
    flex: 1;
    background: var(--color-input-background);
    border-radius: var(--style-border-radius-inputs);
    border: var(--style-border-width-inputs) solid var(--color-input-border);
    transition: border-color 0.18s ease, box-shadow 0.18s ease;
    overflow: hidden;
  }

  .contact-form__compose:hover {
    border-color: color-mix(in srgb, var(--brand-red, #b11c3d) 35%, var(--color-input-border));
  }

  .contact-form__compose:focus-within {
    border-color: var(--brand-red, #b11c3d);
    outline: 3px solid color-mix(in srgb, var(--brand-red, #b11c3d) 18%, transparent);
    outline-offset: 0;
  }

  .contact-form__compose .contact-form__input--textarea,
  .contact-form__compose .contact-form__input--textarea:hover,
  .contact-form__compose .contact-form__input--textarea:focus,
  .contact-form__compose .contact-form__input--textarea:focus-visible {
    border: none !important;
    background: transparent !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    outline: none !important;
  }

  .contact-form__compose .contact-form__input--textarea {
    min-height: 200px;
    width: 100%;
    display: block;
    flex: 1;
  }

  .contact-form__actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--gap-md);
    flex-wrap: wrap;
    margin-top: var(--gap-sm);
  }

  .contact-form__compose .contact-form__actions {
    justify-content: space-between;
    padding: 10px 14px 12px;
    margin-top: 0;
    border-top: 1px solid color-mix(in srgb, currentColor 12%, transparent);
    gap: var(--gap-sm);
    flex-wrap: nowrap;
  }

  .contact-form__compose .contact-form__trust {
    flex: 1;
    min-width: 0;
  }

  .contact-form__trust {
    font-size: 13px;
    line-height: 1.4;
    opacity: 0.65;
  }

  .contact-form__error,
  .contact-form__success {
    display: flex;
    align-items: center;
    gap: var(--gap-xs);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.contact_form",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "form_header",
      "label": "Form header"
    },
    {
      "type": "textarea",
      "id": "form_intro",
      "label": "Form intro"
    },
    {
      "type": "text",
      "id": "trust_microcopy",
      "label": "Trust microcopy (near submit)"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width_desktop",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:settings.width_mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:settings.width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.contact_form",
      "category": "t:categories.forms"
    }
  ]
}
{% endschema %}
