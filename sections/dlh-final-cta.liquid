{{ 'dlh-final-cta.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign bg_image = section.settings.image
  assign bg_asset = section.settings.image_asset
  assign featured_image = section.settings.featured_image
  assign featured_asset = section.settings.featured_image_asset
  assign safari_product = section.settings.product
  assign primary_url = section.settings.primary_url
  if primary_url == blank and safari_product != blank
    assign primary_url = safari_product.url
  endif
  assign has_bg = false
  if bg_image != blank or bg_asset != blank
    assign has_bg = true
  endif
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="section section--full-width color-{{ section.settings.color_scheme }} dlh-final-cta{% if has_bg %} dlh-final-cta--photo{% endif %} spacing-style"
  {% if section.settings.heading != blank or section.settings.heading_accent != blank %}
    aria-labelledby="SafariInvitation-{{ section.id }}"
  {% endif %}
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% if has_bg %}
      --dlh-final-cta-veil: {{ section.settings.image_veil | divided_by: 100.0 }};
      --dlh-final-cta-focus: {{ section.settings.image_position }}%;
    {% endif %}
  "
>
  {%- if has_bg -%}
    {%- comment -%} Decorative texture behind a scheme-colored veil; the featured photo carries the scene. {%- endcomment -%}
    <div class="dlh-final-cta__media" aria-hidden="true">
      {%- if bg_image != blank -%}
        {{
          bg_image
          | image_url: width: 2400
          | image_tag:
            class: 'dlh-final-cta__img',
            loading: 'lazy',
            decoding: 'async',
            widths: '750, 1100, 1500, 2000, 2400',
            sizes: '100vw',
            alt: ''
        }}
      {%- else -%}
        {%- assign bg_src = bg_asset | asset_url -%}
        <img
          class="dlh-final-cta__img"
          src="{{ bg_src }}"

          alt=""
          width="1280"
          height="853"
          loading="lazy"
          decoding="async"
        >
      {%- endif -%}
    </div>
  {%- endif -%}
  <span class="dlh-final-cta__glow" aria-hidden="true"></span>
  <svg class="dlh-final-cta__contours" viewBox="0 0 1440 400" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path d="M-100 280C180 30 390 420 760 180S1190 20 1540 130"/>
    <path d="M-100 310C180 60 390 450 760 210S1190 50 1540 160"/>
    <path d="M-100 340C180 90 390 480 760 240S1190 80 1540 190"/>
    <path d="M-100 370C180 120 390 510 760 270S1190 110 1540 220"/>
  </svg>
  <div class="dlh-final-cta__inner{% if featured_image != blank or featured_asset != blank %} dlh-final-cta__inner--split{% endif %}">
    <div class="dlh-final-cta__content">
    {% if section.settings.eyebrow != blank %}
      <p class="dlh-final-cta__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}
    {% if section.settings.heading != blank or section.settings.heading_accent != blank %}
      <h2 id="SafariInvitation-{{ section.id }}" class="dlh-final-cta__heading">
        {% if section.settings.heading != blank %}{{ section.settings.heading | escape }}{% endif %}
        {% if section.settings.heading_accent != blank %}
          <span class="dlh-final-cta__heading-accent"> {{ section.settings.heading_accent | escape }}</span>
        {% endif %}
      </h2>
    {% endif %}
    {% if section.settings.experience_name != blank %}
      <p class="dlh-final-cta__experience">{{ section.settings.experience_name | escape }}</p>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <p class="dlh-final-cta__sub">{{ section.settings.subheading | escape }}</p>
    {% endif %}
    {% if section.blocks.size > 0 %}
      <ol class="dlh-final-cta__moments" role="list">
        {% for block in section.blocks %}
          <li class="dlh-final-cta__moment" {{ block.shopify_attributes }}>
            <span class="dlh-final-cta__number" aria-hidden="true">0{{ forloop.index }}</span>
            <div>
              <p class="dlh-final-cta__moment-title">{{ block.settings.title | escape }}</p>
              {% if block.settings.detail != blank %}
                <p class="dlh-final-cta__moment-detail">{{ block.settings.detail | escape }}</p>
              {% endif %}
            </div>
          </li>
        {% endfor %}
      </ol>
    {% endif %}
    <div class="dlh-final-cta__buttons">
      {% if section.settings.primary_label != blank and primary_url != blank %}
        <a href="{{ primary_url }}" class="dlh-final-cta__btn dlh-final-cta__btn--primary">
          {{ section.settings.primary_label | escape }}
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" focusable="false"><path d="M4 12h16m-6-6 6 6-6 6"/></svg>
        </a>
      {% endif %}
      {% if section.settings.secondary_label != blank and section.settings.secondary_url != blank %}
        <a
          href="{{ section.settings.secondary_url }}"
          class="dlh-final-cta__btn dlh-final-cta__btn--outline"
          {% if section.settings.secondary_url contains 'wa.me' or section.settings.secondary_url contains 'whatsapp' %}
            target="_blank" rel="noopener"
          {% endif %}
        >
          {{ section.settings.secondary_label | escape }}
        </a>
      {% endif %}
    </div>
    {% if section.settings.reassurance != blank %}
      <p class="dlh-final-cta__reassurance">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" focusable="false"><path d="M12 3 4 6v6c0 5 8 9 8 9s8-4 8-9V6z"/><path d="m8 12 3 3 5-6"/></svg>
        {{ section.settings.reassurance | escape }}
      </p>
    {% endif %}
    </div>
    {% if featured_image != blank or featured_asset != blank %}
      <figure class="dlh-final-cta__visual">
        <div class="dlh-final-cta__photo-wrap">
          {% if featured_image != blank %}
            {{ featured_image | image_url: width: 1400 | image_tag: class: 'dlh-final-cta__photo', loading: 'lazy', decoding: 'async', widths: '400, 600, 800, 1000, 1400', sizes: '(min-width: 990px) 42vw, 100vw' }}
          {% else %}
            <img class="dlh-final-cta__photo" src="{{ featured_asset | asset_url }}" width="1000" height="1241" alt="{{ section.settings.featured_image_alt | escape }}" loading="lazy" decoding="async">
          {% endif %}
        </div>
        <span class="dlh-final-cta__sun" aria-hidden="true">
          <svg width="42" height="42" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.4" focusable="false"><path d="M14 29a10 10 0 0 1 20 0M6 29h36M11 35h26M17 41h14M24 4v7M7 12l5 5M41 12l-5 5M3 23h6M39 23h6"/></svg>
        </span>
        {% if section.settings.image_caption != blank %}
          <figcaption class="dlh-final-cta__caption">
            {% if section.settings.image_eyebrow != blank %}<span>{{ section.settings.image_eyebrow | escape }}</span>{% endif %}
            {{ section.settings.image_caption | escape }}
          </figcaption>
        {% endif %}
      </figure>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Final CTA band",
  "tag": "div",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 3,
  "blocks": [
    {
      "type": "moment",
      "name": "Safari moment",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Golden-hour dunes" },
        { "type": "text", "id": "detail", "label": "Short description" }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Your Dubai trip deserves this"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The dunes are"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent",
      "default": "waiting."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Leave the skyline behind. Chase the sunset across the red dunes, then settle into a desert camp for BBQ and live shows under the stars."
    },
    {
      "type": "text",
      "id": "experience_name",
      "label": "Experience name",
      "default": "Evening Desert Safari"
    },
    {
      "type": "text",
      "id": "reassurance",
      "label": "Booking reassurance",
      "default": "Free cancellation up to 24 hours · Instant confirmation"
    },
    {
      "type": "header",
      "content": "Primary button"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Safari product",
      "info": "Used for the main button when no URL is set below."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Label",
      "default": "Book evening desert safari"
    },
    {
      "type": "url",
      "id": "primary_url",
      "label": "URL"
    },
    {
      "type": "header",
      "content": "Secondary button"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Label",
      "default": "Chat on WhatsApp"
    },
    {
      "type": "url",
      "id": "secondary_url",
      "label": "URL"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    { "type": "header", "content": "Featured safari photo" },
    { "type": "image_picker", "id": "featured_image", "label": "Photo" },
    { "type": "text", "id": "featured_image_asset", "label": "Photo (theme asset file name)", "default": "dlh-safari-sunset.webp", "info": "Used when no featured photo is picked." },
    { "type": "text", "id": "featured_image_alt", "label": "Asset photo description", "default": "4x4 safari vehicles crossing golden desert dunes at sunset" },
    { "type": "text", "id": "image_eyebrow", "label": "Photo eyebrow", "default": "Beyond the skyline" },
    { "type": "text", "id": "image_caption", "label": "Photo caption", "default": "A different side of Dubai." },
    {
      "type": "header",
      "content": "Background photo"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo"
    },
    {
      "type": "text",
      "id": "image_asset",
      "label": "Photo (theme asset file name)",
      "info": "Used when no photo is picked above, e.g. dlh-camp-evening.webp"
    },
    {
      "type": "range",
      "id": "image_veil",
      "label": "Color veil over the photo",
      "info": "Uses the section background color. Higher keeps the text easier to read.",
      "min": 40,
      "max": 95,
      "step": 5,
      "unit": "%",
      "default": 80
    },
    {
      "type": "range",
      "id": "image_position",
      "label": "Part of the photo shown",
      "info": "The band is wider than the photo, so only a strip of it shows. 0% is the top of the photo, 100% the bottom.",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 88
    }
  ],
  "presets": [
    {
      "name": "Final CTA band",
      "category": "t:categories.storytelling",
      "blocks": [
        { "type": "moment", "settings": { "title": "Feel the rush", "detail": "4x4 dune bashing" } },
        { "type": "moment", "settings": { "title": "Chase the sunset", "detail": "Golden-hour views" } },
        { "type": "moment", "settings": { "title": "Stay for the stars", "detail": "BBQ & live shows" } }
      ]
    }
  ]
}
{% endschema %}
