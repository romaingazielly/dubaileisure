{{ 'timeline-steps.css' | asset_url | stylesheet_tag: preload: true }}

{%- liquid
  assign scheme = section.settings.color_scheme
  if scheme == blank
    assign scheme = 'scheme-5'
  endif

  comment
    Palette apres-midi vers nuit : chaque etape prend la teinte correspondant a sa position.
    Les numeros (pastille sans illustration, grand numero en face de la carte) viennent d'un compteur CSS.
  endcomment
  assign step_palette = '#f6c56f,#f3a650,#ee8a3c,#e86a38,#dc4a45,#c2457a,#9358b8,#7183e0' | split: ','
  assign last_step_index = section.blocks.size | minus: 1 | at_least: 1
-%}

<div class="section-background color-{{ scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-{{ scheme }} timeline-steps{% if section.settings.show_glow %} timeline-steps--decor{% endif %} spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  {%- if section.settings.show_glow -%}
    <span class="timeline-steps__sky"></span>
    {%- comment -%} Les traces debordent du cadre pour que leur contour ne dessine pas de trait sur les bords {%- endcomment -%}
    <svg class="timeline-steps__dunes" aria-hidden="true" viewBox="0 0 1440 260" preserveAspectRatio="none">
      <path d="M-20 200C200 130 380 110 560 155s320 65 500 5 260-60 400-15V290H-20z"/>
      <path d="M-20 250c170-50 310-80 490-50s290 65 490 20 320-60 500-10V290H-20z"/>
    </svg>
  {%- endif -%}

  <div
    class="timeline-steps__inner"
    style="--timeline-max-width: {{ section.settings.max_width }}px; --timeline-accent: {{ section.settings.accent_color }};"
  >
    <div class="timeline-steps__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="timeline-steps__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="timeline-steps__heading">
          {{- section.settings.heading -}}
          {%- if section.settings.heading_accent != blank %}
            <span class="timeline-steps__heading-accent">{{ section.settings.heading_accent }}</span>
          {%- endif -%}
        </h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="timeline-steps__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <ol class="timeline-steps__list" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign palette_index = forloop.index0 | times: 7.0 | divided_by: last_step_index | round
          assign illustration = block.settings.illustration | default: 'none'
        -%}
        <li
          class="timeline-steps__item"
          style="--step-color: {{ step_palette[palette_index] }};"
          {{ block.shopify_attributes }}
        >
          <div class="timeline-steps__dot" aria-hidden="true">
            {%- if illustration != 'none' -%}
              <svg class="timeline-steps__dot-icon" viewBox="0 0 24 24">
                {%- render 'timeline-step-illustration', name: illustration -%}
              </svg>
            {%- endif -%}
          </div>
          <div class="timeline-steps__content">
            {%- if block.settings.title != blank -%}
              <h3 class="timeline-steps__title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <p class="timeline-steps__description">{{ block.settings.description }}</p>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</div>

{% schema %}
{
  "name": "Timeline steps",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre",
      "default": "YOUR EVENING · HOUR BY HOUR"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "What actually"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Titre accentue (2e ligne)",
      "info": "S'affiche sur une seconde ligne, dans la couleur d'accent.",
      "default": "happens."
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Sous-titre",
      "info": "Le texte en gras est mis en avant en dore.",
      "default": "No vague desert experience marketing. Here is exactly what six hours with us looks like, from pickup to drop-off."
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Couleur d'accent",
      "default": "#d7781a"
    },
    {
      "type": "checkbox",
      "id": "show_glow",
      "label": "Afficher le decor",
      "info": "Lueurs, ciel etoile et dunes en fond de section.",
      "default": true
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Largeur max du composant",
      "min": 900,
      "max": 1800,
      "step": 10,
      "unit": "px",
      "default": 1440
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Schema de couleurs",
      "default": "scheme-5"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Largeur section",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Pleine largeur" }
      ],
      "default": "full-width"
    },
    {
      "type": "header",
      "content": "Espacements"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding haut",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bas",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Etape",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "Hotel Pickup"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "AC Land Cruiser, direct a la porte"
        },
        {
          "type": "select",
          "id": "illustration",
          "label": "Illustration dans la pastille",
          "info": "Remplace le numero dans la pastille.",
          "options": [
            { "value": "none", "label": "Aucune" },
            { "value": "car", "label": "4x4 / transfert" },
            { "value": "quad", "label": "Quad" },
            { "value": "dunes", "label": "Dunes" },
            { "value": "sunset", "label": "Coucher de soleil" },
            { "value": "tent", "label": "Campement" },
            { "value": "grill", "label": "Barbecue" },
            { "value": "flame", "label": "Spectacle de feu" },
            { "value": "moon", "label": "Nuit" },
            { "value": "hotel", "label": "Hotel" }
          ],
          "default": "none"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Timeline steps",
      "blocks": [
        { "type": "step", "settings": { "title": "Hotel Pickup", "description": "AC Land Cruiser, direct a la porte", "illustration": "car" } },
        { "type": "step", "settings": { "title": "Desert Activities", "description": "Quad, sandboard, camel ride, falcon photo", "illustration": "quad" } },
        { "type": "step", "settings": { "title": "Dune Bashing", "description": "30 min dans les dunes rouges", "illustration": "dunes" } },
        { "type": "step", "settings": { "title": "Sunset + BBQ", "description": "Buffet international, lanternes arabes", "illustration": "grill" } },
        { "type": "step", "settings": { "title": "Live Shows", "description": "Tanoura, belly dance, fire show", "illustration": "flame" } },
        { "type": "step", "settings": { "title": "Hotel Drop-off", "description": "Retour vers 9 PM", "illustration": "moon" } }
      ]
    }
  ]
}
{% endschema %}
