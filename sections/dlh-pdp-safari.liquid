{{ 'dlh-pdp-vehicle.css' | asset_url | stylesheet_tag }}
{{ 'dlh-pdp-safari.css' | asset_url | stylesheet_tag }}
{% render 'dlh-pdp-icons' %}

{%- liquid
  comment
    Group-tour product page: each variant is a participant type (Adult, Child…).
    Guests pick a date and a number of guests per type; every type becomes a cart line.
  endcomment
  assign dlh_variants = product.variants | sort: 'price' | reverse
  assign dlh_lead_variant = dlh_variants | first
  assign dlh_media_count = product.media.size
  assign dlh_fact_blocks = section.blocks | where: 'type', 'fact'
-%}

{%- capture dlh_calendar_popup -%}
  <div class="dlh-pv__cal" data-cal-popup>
    <div class="dlh-pv__cal-head">
      <span class="dlh-pv__cal-title" data-cal-month-title></span>
      <div class="dlh-pv__cal-nav">
        <button type="button" data-cal-prev aria-label="Previous month"><svg width="14" height="14"><use href="#dlh-ico-chevl"/></svg></button>
        <button type="button" data-cal-next aria-label="Next month"><svg width="14" height="14"><use href="#dlh-ico-chevr"/></svg></button>
      </div>
    </div>
    <div class="dlh-pv__cal-grid">
      {%- assign dow = 'S,M,T,W,T,F,S' | split: ',' -%}
      {%- for d in dow -%}
        <div class="dlh-pv__cal-dow">{{ d }}</div>
      {%- endfor -%}
      <div data-cal-days style="display:contents"></div>
    </div>
  </div>
{%- endcapture -%}

<div class="dlh-ps" data-section-id="{{ section.id }}">
  <header class="dlh-ps__hero">
    <dlh-pdp-gallery class="dlh-pv__gal">
      <div class="dlh-pv__main">
        {%- for media in product.media -%}
          <div class="dlh-pv__slide {% if forloop.first %}is-active{% endif %}" data-slide>
            {%- if media.media_type == 'image' -%}
              {%- liquid
                comment
                  First image = LCP element: eager, preloaded, high fetch priority. The hero spans the viewport.
                endcomment
                assign dlh_loading = 'lazy'
                assign dlh_fetch = 'low'
                assign dlh_preload = false
                if forloop.first
                  assign dlh_loading = 'eager'
                  assign dlh_fetch = 'high'
                  assign dlh_preload = true
                endif
              -%}
              {{
                media
                | image_url: width: 2400
                | image_tag:
                  loading: dlh_loading,
                  fetchpriority: dlh_fetch,
                  preload: dlh_preload,
                  widths: '480, 750, 1100, 1500, 2000, 2400',
                  sizes: '100vw',
                  alt: media.alt
              }}
            {%- elsif media.media_type == 'video' -%}
              {{ media | video_tag: autoplay: false, loop: true, muted: true, controls: true, class: 'dlh-pv__video' }}
            {%- elsif media.media_type == 'external_video' -%}
              {{ media | external_video_tag }}
            {%- endif -%}
          </div>
        {%- endfor -%}

        {%- if dlh_media_count > 1 -%}
          <div class="dlh-pv__arrows">
            <button class="dlh-pv__arrow" data-prev aria-label="Previous" type="button">
              <svg width="18" height="18"><use href="#dlh-ico-chevl"/></svg>
            </button>
            <button class="dlh-pv__arrow" data-next aria-label="Next" type="button">
              <svg width="18" height="18"><use href="#dlh-ico-chevr"/></svg>
            </button>
          </div>
          <div class="dlh-pv__dots">
            {%- for media in product.media -%}
              <button class="dlh-pv__dot {% if forloop.first %}is-active{% endif %}" data-dot type="button" aria-label="Slide {{ forloop.index }}"></button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </dlh-pdp-gallery>

    <div class="dlh-ps__hero-inner">
      <div class="dlh-ps__hero-text">
        <p class="dlh-ps__eyebrow">
          {%- if section.settings.badge_text != blank -%}
            <span class="dlh-ps__badge">{{ section.settings.badge_text }}</span>
          {%- endif -%}
          {{ section.settings.category_text }}
        </p>
        <h1 class="dlh-ps__title">
          {{ product.title }}
          {%- if section.settings.title_accent != blank -%}
            <span>{{ section.settings.title_accent }}</span>
          {%- endif -%}
        </h1>
        {%- if section.settings.rating != blank -%}
          <a class="dlh-ps__rating" href="#reviews">
            <span class="dlh-ps__stars" aria-hidden="true">
              {%- for i in (1..5) -%}
                <svg width="16" height="16"><use href="#dlh-ico-star"/></svg>
              {%- endfor -%}
            </span>
            <b>{{ section.settings.rating }}</b>
            {%- if section.settings.review_count != blank -%}
              <span>{{ section.settings.review_count }}</span>
            {%- endif -%}
          </a>
        {%- endif -%}
      </div>
    </div>
  </header>

  <div class="dlh-ps__body">
    <div class="dlh-ps__info">
      {%- if section.settings.summary != blank -%}
        <p class="dlh-ps__summary">{{ section.settings.summary }}</p>
      {%- endif -%}

      {%- if dlh_fact_blocks.size > 0 -%}
        <ul class="dlh-ps__facts" role="list">
          {%- for block in dlh_fact_blocks -%}
            <li class="dlh-ps__fact" {{ block.shopify_attributes }}>
              <span class="dlh-ps__fact-icon">
                <svg width="20" height="20" aria-hidden="true"><use href="#dlh-ico-{{ block.settings.icon }}"/></svg>
              </span>
              <span>
                <b>{{ block.settings.label }}</b>
                {%- if block.settings.detail != blank -%}
                  <small>{{ block.settings.detail }}</small>
                {%- endif -%}
              </span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- assign dlh_trust_blocks = section.blocks | where: 'type', 'trust_item' -%}
      {%- if dlh_trust_blocks.size > 0 -%}
        <ul class="dlh-ps__trust" role="list">
          {%- for block in dlh_trust_blocks -%}
            <li {{ block.shopify_attributes }}>
              <svg width="16" height="16" aria-hidden="true"><use href="#dlh-ico-{{ block.settings.icon }}"/></svg>
              {{ block.settings.label }}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.whatsapp_url != blank -%}
        <a href="{{ section.settings.whatsapp_url }}" class="dlh-ps__help" target="_blank" rel="noopener">
          <svg width="20" height="20" aria-hidden="true"><use href="#dlh-ico-wa"/></svg>
          <span><b>{{ section.settings.whatsapp_title }}</b> {{ section.settings.whatsapp_text }}</span>
        </a>
      {%- endif -%}
    </div>

  <dlh-safari-booking
    class="dlh-ps__card"
    id="booking"
    data-money-format="{{ shop.money_format | escape }}"
    data-cart-add-url="{{ routes.cart_add_url }}.js"
    data-cart-url="{{ routes.cart_url }}"
    data-max-guests="{{ section.settings.max_guests }}"
    data-product-title="{{ product.title | escape }}"
  >
    <div class="dlh-ps__card-head">
      <div>
        <span class="dlh-ps__from">{{ section.settings.price_prefix }}</span>
        <span class="dlh-pv__price-now">{{ dlh_lead_variant.price | money }}</span>
        <span class="dlh-ps__per">{{ section.settings.price_unit }}</span>
      </div>
      {%- if section.settings.price_note != blank -%}
        <p class="dlh-pv__price-unit">{{ section.settings.price_note }}</p>
      {%- endif -%}
    </div>

    <form class="dlh-ps__form" novalidate data-booking-form>
      <dlh-safari-date class="dlh-pv__field dlh-pv__date-field">
        <div class="dlh-pv__label">
          <span>{{ section.settings.date_label }}</span>
        </div>
        <button type="button" class="dlh-pv__date-trigger" data-cal-trigger aria-describedby="dlh-ps-date-error">
          <span class="dlh-pv__date-val">
            <svg width="18" height="18" aria-hidden="true"><use href="#dlh-ico-cal"/></svg>
            <span class="dlh-pv__date-txt dlh-pv__date-txt--placeholder" data-date-label>Select a date</span>
          </span>
          <svg class="dlh-pv__date-caret" width="14" height="14" aria-hidden="true"><use href="#dlh-ico-chevd"/></svg>
        </button>
        <input type="hidden" name="properties[Date]" value="">
        <p class="dlh-ps__error" id="dlh-ps-date-error" data-date-error hidden>Please choose a date to continue.</p>

        {{ dlh_calendar_popup }}
      </dlh-safari-date>

      <div class="dlh-pv__field">
        <div class="dlh-pv__label">
          <span>{{ section.settings.guests_label }}</span>
        </div>
        <div class="dlh-ps__guests">
          {%- for variant in dlh_variants -%}
            {%- liquid
              assign dlh_name_parts = variant.title | split: '('
              assign dlh_guest_name = dlh_name_parts | first | strip
              assign dlh_guest_hint = dlh_name_parts[1] | remove: ')' | strip | capitalize
              if product.has_only_default_variant
                assign dlh_guest_name = section.settings.single_guest_label
              endif
              assign dlh_default_qty = 0
              if forloop.first
                assign dlh_default_qty = section.settings.default_guests
              endif
            -%}
            <div
              class="dlh-ps__guest"
              data-guest
              data-variant-id="{{ variant.id }}"
              data-price="{{ variant.price }}"
              {% unless variant.available %}data-unavailable{% endunless %}
            >
              <div class="dlh-ps__guest-info">
                <b>{{ dlh_guest_name }}</b>
                <small>
                  {%- if dlh_guest_hint != blank -%}{{ dlh_guest_hint }} · {% endif -%}
                  {{ variant.price | money }}
                </small>
              </div>
              <div class="dlh-ps__stepper">
                <button type="button" data-step="-1" aria-label="Remove one {{ dlh_guest_name | escape }}">
                  <svg width="16" height="16" aria-hidden="true"><use href="#dlh-ico-minus"/></svg>
                </button>
                <output data-qty aria-live="polite">{% if variant.available %}{{ dlh_default_qty }}{% else %}0{% endif %}</output>
                <button type="button" data-step="1" aria-label="Add one {{ dlh_guest_name | escape }}" {% unless variant.available %}disabled{% endunless %}>
                  <svg width="16" height="16" aria-hidden="true"><use href="#dlh-ico-plus"/></svg>
                </button>
              </div>
            </div>
          {%- endfor -%}
        </div>
        {%- if section.settings.guests_note != blank -%}
          <p class="dlh-ps__note">{{ section.settings.guests_note }}</p>
        {%- endif -%}
        <p class="dlh-ps__error" data-guests-error hidden>Please add at least one guest.</p>
      </div>

      {%- comment -%}
        Upsells: each block points to a real product, added to the cart as its own line
        with the chosen quantity. Shown once a date and at least one guest are picked.
      {%- endcomment -%}
      {%- assign dlh_upsell_blocks = section.blocks | where: 'type', 'upsell' -%}
      {%- if dlh_upsell_blocks.size > 0 -%}
        <div class="dlh-pv__field dlh-ps__upsells-field" data-upsell-field hidden>
          <div class="dlh-pv__label">
            <span>{{ section.settings.upsells_label }}</span>
            {%- if section.settings.upsells_hint != blank -%}
              <span class="dlh-pv__hint">{{ section.settings.upsells_hint }}</span>
            {%- endif -%}
          </div>
          <div class="dlh-ps__upsells">
            {%- for block in dlh_upsell_blocks -%}
              {%- assign dlh_upsell_product = block.settings.product -%}
              {%- assign dlh_upsell_variant = dlh_upsell_product.selected_or_first_available_variant -%}
              {%- if dlh_upsell_product == blank or dlh_upsell_variant.available != true -%}
                {%- if request.design_mode -%}
                  <p class="dlh-ps__upsell-missing" {{ block.shopify_attributes }}>
                    Upsell hidden: pick an available product for this block.
                  </p>
                {%- endif -%}
                {%- continue -%}
              {%- endif -%}
              {%- assign dlh_upsell_title = block.settings.title | default: dlh_upsell_product.title -%}
              <div
                class="dlh-ps__upsell"
                data-upsell
                data-variant-id="{{ dlh_upsell_variant.id }}"
                data-price="{{ dlh_upsell_variant.price }}"
                data-max="{{ block.settings.max_quantity }}"
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.show_image and dlh_upsell_product.featured_image != blank -%}
                  {{ dlh_upsell_product.featured_image | image_url: width: 120 | image_tag: class: 'dlh-ps__upsell-img', width: 56, height: 56, loading: 'lazy', alt: '' }}
                {%- endif -%}
                <div class="dlh-ps__upsell-info">
                  <b>{{ dlh_upsell_title }}</b>
                  <span class="dlh-ps__upsell-price">
                    +{{ dlh_upsell_variant.price | money }}
                    {%- if block.settings.price_suffix != blank %} <small>{{ block.settings.price_suffix }}</small>{% endif -%}
                  </span>
                  {%- if block.settings.description != blank -%}
                    <small class="dlh-ps__upsell-desc">{{ block.settings.description }}</small>
                  {%- endif -%}
                </div>
                <div class="dlh-ps__stepper dlh-ps__stepper--sm">
                  <button type="button" data-step="-1" aria-label="Remove one {{ dlh_upsell_title | escape }}" disabled>
                    <svg width="14" height="14" aria-hidden="true"><use href="#dlh-ico-minus"/></svg>
                  </button>
                  <output data-qty aria-live="polite">0</output>
                  <button type="button" data-step="1" aria-label="Add one {{ dlh_upsell_title | escape }}">
                    <svg width="14" height="14" aria-hidden="true"><use href="#dlh-ico-plus"/></svg>
                  </button>
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      <div class="dlh-ps__total">
        <span>
          Total
          <small data-total-detail></small>
        </span>
        <b data-total>{{ dlh_lead_variant.price | times: section.settings.default_guests | money }}</b>
      </div>

      <div class="dlh-pv__ctas dlh-ps__ctas">
        <button type="submit" class="dlh-pv__cta dlh-pv__cta--primary" data-action="checkout">
          {{ section.settings.primary_label }}
        </button>
        {%- if section.settings.show_add_to_cart -%}
          <button type="submit" class="dlh-pv__cta dlh-pv__cta--ghost" data-action="cart">
            <svg width="18" height="18" aria-hidden="true"><use href="#dlh-ico-cart"/></svg>
            Add to cart
          </button>
        {%- endif -%}
      </div>
      <p class="dlh-ps__error" data-form-error role="alert" hidden></p>
    </form>

    {%- assign dlh_reass_blocks = section.blocks | where: 'type', 'reassurance' -%}
    {%- if dlh_reass_blocks.size > 0 -%}
      <div class="dlh-pv__reass">
        {%- for block in dlh_reass_blocks -%}
          <span class="dlh-pv__reass-item" {{ block.shopify_attributes }}>
            <svg width="14" height="14" aria-hidden="true"><use href="#dlh-ico-check"/></svg>
            {{ block.settings.text }}
          </span>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </dlh-safari-booking>
  </div>
</div>

<div class="dlh-ps__bar" data-booking-bar hidden>
  <div class="dlh-ps__bar-inner">
    <p class="dlh-ps__bar-title">{{ product.title }}</p>
    <dlh-safari-date class="dlh-ps__bar-date dlh-pv__date-field">
      <button type="button" class="dlh-pv__date-trigger" data-cal-trigger aria-label="{{ section.settings.date_label | escape }}">
        <span class="dlh-pv__date-val">
          <svg width="18" height="18" aria-hidden="true"><use href="#dlh-ico-cal"/></svg>
          <span class="dlh-pv__date-txt dlh-pv__date-txt--placeholder" data-date-label>Select a date</span>
        </span>
        <svg class="dlh-pv__date-caret" width="14" height="14" aria-hidden="true"><use href="#dlh-ico-chevd"/></svg>
      </button>
      {{ dlh_calendar_popup }}
    </dlh-safari-date>
    <div class="dlh-ps__bar-price">
      <b data-bar-total>{{ dlh_lead_variant.price | times: section.settings.default_guests | money }}</b>
      <small data-bar-detail></small>
    </div>
    <button type="button" class="dlh-pv__cta dlh-pv__cta--primary" data-bar-cta>{{ section.settings.primary_label }}</button>
  </div>
</div>

<script src="{{ 'dlh-pdp-vehicle.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'dlh-pdp-safari.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Safari PDP",
  "tag": "div",
  "class": "dlh-section-pdp-safari",
  "settings": [
    { "type": "header", "content": "Product header" },
    { "type": "text", "id": "category_text", "label": "Category eyebrow", "default": "Desert Safari · Dubai" },
    { "type": "text", "id": "title_accent", "label": "Title accent" },
    { "type": "text", "id": "badge_text", "label": "Image badge", "default": "Bestseller" },
    { "type": "text", "id": "rating", "label": "Rating score", "default": "4.9" },
    { "type": "text", "id": "review_count", "label": "Review count text", "default": "1,250+ reviews" },
    { "type": "textarea", "id": "summary", "label": "One-line summary" },
    { "type": "header", "content": "Booking card" },
    { "type": "text", "id": "price_prefix", "label": "Price prefix", "default": "From" },
    { "type": "text", "id": "price_unit", "label": "Price unit", "default": "per adult" },
    { "type": "text", "id": "price_note", "label": "Price note", "default": "Taxes & fees included" },
    { "type": "text", "id": "date_label", "label": "Date label", "default": "Pick your date" },
    { "type": "text", "id": "guests_label", "label": "Guests label", "default": "Guests" },
    { "type": "text", "id": "single_guest_label", "label": "Guest label (product without variants)", "default": "Guests" },
    { "type": "text", "id": "guests_note", "label": "Note under guests" },
    { "type": "range", "id": "default_guests", "label": "Guests preselected", "min": 1, "max": 4, "step": 1, "default": 2 },
    { "type": "range", "id": "max_guests", "label": "Maximum guests per booking", "min": 4, "max": 40, "step": 1, "default": 20 },
    { "type": "text", "id": "upsells_label", "label": "Upsells label", "default": "Add to your evening" },
    { "type": "text", "id": "upsells_hint", "label": "Upsells hint", "default": "Optional" },
    { "type": "text", "id": "primary_label", "label": "Main button label", "default": "Book now" },
    { "type": "checkbox", "id": "show_add_to_cart", "label": "Show Add to cart button", "default": true },
    { "type": "header", "content": "WhatsApp help" },
    { "type": "url", "id": "whatsapp_url", "label": "WhatsApp link" },
    { "type": "text", "id": "whatsapp_title", "label": "Help title", "default": "Questions before booking?" },
    { "type": "text", "id": "whatsapp_text", "label": "Help text", "default": "Chat with us on WhatsApp." }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Key fact",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "pickup", "label": "4x4 pickup" },
            { "value": "heritage", "label": "Desert sunset" },
            { "value": "camp", "label": "Desert camp" },
            { "value": "guide", "label": "Guide / compass" },
            { "value": "award", "label": "Award" },
            { "value": "insured", "label": "Insured" },
            { "value": "cancel", "label": "Free cancellation" },
            { "value": "instant", "label": "Instant confirmation" },
            { "value": "group", "label": "Group" },
            { "value": "star", "label": "Star" },
            { "value": "clock", "label": "Clock" },
            { "value": "truck", "label": "Pickup" },
            { "value": "users", "label": "Guests" },
            { "value": "globe", "label": "Globe" },
            { "value": "refund", "label": "Refund" },
            { "value": "bolt", "label": "Bolt" },
            { "value": "shield", "label": "Shield" },
            { "value": "fire", "label": "Fire" },
            { "value": "mobile", "label": "Mobile" }
          ],
          "default": "clock"
        },
        { "type": "text", "id": "label", "label": "Label", "default": "Evening experience" },
        { "type": "text", "id": "detail", "label": "Detail" }
      ]
    },
    {
      "type": "trust_item",
      "name": "Trust item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "pickup", "label": "4x4 pickup" },
            { "value": "heritage", "label": "Desert sunset" },
            { "value": "camp", "label": "Desert camp" },
            { "value": "guide", "label": "Guide / compass" },
            { "value": "award", "label": "Award" },
            { "value": "insured", "label": "Insured" },
            { "value": "cancel", "label": "Free cancellation" },
            { "value": "instant", "label": "Instant confirmation" },
            { "value": "group", "label": "Group" },
            { "value": "star", "label": "Star" },
            { "value": "shield", "label": "Shield" },
            { "value": "bolt", "label": "Bolt" },
            { "value": "refund", "label": "Refund" },
            { "value": "mobile", "label": "Mobile" },
            { "value": "truck", "label": "Pickup" },
            { "value": "check", "label": "Check" }
          ],
          "default": "shield"
        },
        { "type": "text", "id": "label", "label": "Label", "default": "Licensed operator" }
      ]
    },
    {
      "type": "upsell",
      "name": "Upsell",
      "settings": [
        {
          "type": "paragraph",
          "content": "Pick a product: its price is charged at checkout, one cart line per upsell. Guests choose a quantity once they have picked a date and their party."
        },
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "title", "label": "Title", "info": "Leave empty to use the product title." },
        { "type": "text", "id": "description", "label": "Short description" },
        { "type": "text", "id": "price_suffix", "label": "Price suffix", "default": "per person" },
        { "type": "range", "id": "max_quantity", "label": "Maximum quantity", "min": 1, "max": 20, "step": 1, "default": 10 },
        { "type": "checkbox", "id": "show_image", "label": "Show product image", "default": true }
      ]
    },
    {
      "type": "reassurance",
      "name": "Reassurance item",
      "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Secure payment" }]
    }
  ],
  "presets": [{ "name": "Safari PDP", "category": "Product" }]
}
{% endschema %}
