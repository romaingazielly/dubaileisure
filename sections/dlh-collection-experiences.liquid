{{ 'dlh-collection-experiences.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Collection page body: the collection's products presented as editorial groups.

  Blocks are read in order. A "group" block opens a group, the "experience" blocks that follow belong to it,
  and a "pointer" block is a strip that links back to the signature experience.
  The experience block whose product is the signature experience is rendered as the large navy feature.
  Only products that belong to the current collection are shown, and collection products that have no
  block are listed at the end, so a new product is never missing from the page.
{%- endcomment -%}

{%- liquid
  assign flagship = section.settings.flagship_product
  assign flagship_handle = ''
  if flagship != blank
    assign flagship_handle = flagship.handle
    assign flagship_name = section.settings.flagship_name | default: flagship.title
    assign flagship_price = flagship.price_min
    if section.settings.flagship_price_source == 'max'
      assign flagship_price = flagship.price_max
    endif
  endif

  comment
    Handles wrapped in pipes, so "contains" only matches a whole handle.
  endcomment
  assign coll_handles = '|'
  for coll_product in collection.products
    assign coll_handles = coll_handles | append: coll_product.handle | append: '|'
  endfor

  comment
    First pass: count what each group will show. Index 0 is for experiences placed before the first group.
  endcomment
  assign used_handles = '|'
  assign seg_total = 0
  assign seg_cards = 0
  assign seg_totals = ''
  assign seg_cards_list = ''
  for block in section.blocks
    case block.type
      when 'group'
        assign seg_totals = seg_totals | append: seg_total | append: ','
        assign seg_cards_list = seg_cards_list | append: seg_cards | append: ','
        assign seg_total = 0
        assign seg_cards = 0
      when 'experience'
        assign block_product = block.settings.product
        if block_product != blank
          assign needle = '|' | append: block_product.handle | append: '|'
          if coll_handles contains needle
            assign used_handles = used_handles | append: block_product.handle | append: '|'
            assign seg_total = seg_total | plus: 1
            unless block_product.handle == flagship_handle
              assign seg_cards = seg_cards | plus: 1
            endunless
          endif
        endif
    endcase
  endfor
  assign seg_totals = seg_totals | append: seg_total | split: ','
  assign seg_cards_list = seg_cards_list | append: seg_cards | split: ','

  assign leftover_count = 0
  for coll_product in collection.products
    assign needle = '|' | append: coll_product.handle | append: '|'
    unless used_handles contains needle
      assign leftover_count = leftover_count | plus: 1
    endunless
  endfor
-%}

{%- comment -%} Small photo of the signature experience, reused by every pointer strip {%- endcomment -%}
{%- capture flagship_thumb -%}
  {%- if section.settings.flagship_image_1 != blank -%}
    {{ section.settings.flagship_image_1 | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 160', sizes: '56px', alt: '' }}
  {%- elsif section.settings.flagship_image_1_asset != blank -%}
    <img src="{{ section.settings.flagship_image_1_asset | asset_url }}" alt="" width="1000" height="1250" loading="lazy" decoding="async">
  {%- elsif flagship.featured_image != blank -%}
    {{ flagship.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 160', sizes: '56px', alt: '' }}
  {%- endif -%}
{%- endcapture -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  id="experiences"
  class="section section--full-width color-{{ section.settings.color_scheme }} dlh-cx spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="dlh-cx__inner" {{ section.shopify_attributes }}>
    {%- comment -%} ---------- Jump links ---------- {%- endcomment -%}
    {%- capture nav_items -%}
      {%- assign seg = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'group' -%}
          {%- liquid
            assign seg = seg | plus: 1
            assign seg_n = seg_totals[seg] | plus: 0
            assign anchor = block.settings.anchor | handleize
            if anchor == blank
              assign anchor = 'exp-' | append: block.id
            endif
            assign nav_label = block.settings.nav_label | default: block.settings.heading
          -%}
          {%- if seg_n > 0 and nav_label != blank -%}
            <a class="dlh-cx__chip" href="#{{ anchor }}">
              {{- nav_label | escape -}}
              <span class="dlh-cx__chip-count">{{ seg_n }}</span>
            </a>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if section.settings.show_compare and section.settings.compare_nav_label != blank -%}
        <a class="dlh-cx__chip dlh-cx__chip--ghost" href="#compare">{{ section.settings.compare_nav_label | escape }}</a>
      {%- endif -%}
    {%- endcapture -%}

    {%- if nav_items != blank -%}
      <nav class="dlh-cx__nav" aria-label="{{ section.settings.nav_label | default: 'Experiences' | escape }}">
        {%- if section.settings.nav_label != blank -%}
          <span class="dlh-cx__nav-label">{{ section.settings.nav_label | escape }}</span>
        {%- endif -%}
        <div class="dlh-cx__nav-chips">{{ nav_items }}</div>
      </nav>
    {%- endif -%}

    {%- comment -%} ---------- Groups ---------- {%- endcomment -%}
    {%- liquid
      assign seg = 0
      assign group_open = false
      assign grid_open = false
      assign compare_rows = ''
    -%}

    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'group' -%}
          {%- liquid
            if grid_open
              echo '</div>'
              assign grid_open = false
            endif
            if group_open
              echo '</section>'
              assign group_open = false
            endif

            assign seg = seg | plus: 1
            assign seg_n = seg_totals[seg] | plus: 0
            assign anchor = block.settings.anchor | handleize
            if anchor == blank
              assign anchor = 'exp-' | append: block.id
            endif
          -%}
          {%- if seg_n > 0 -%}
            {%- liquid
              comment
                Group and grid wrappers are opened and closed with echo: they span several blocks of the loop.
              endcomment
              assign group_open = true
              echo '<section class="dlh-cx__group" id="' | append: anchor | append: '" aria-labelledby="' | append: anchor | append: '-title">'
            -%}
              <header class="dlh-cx__group-head" {{ block.shopify_attributes }}>
                <div class="dlh-cx__group-title">
                  {%- if block.settings.eyebrow != blank -%}
                    <p class="dlh-cx__eyebrow">{{ block.settings.eyebrow | escape }}</p>
                  {%- endif -%}
                  <h2 class="dlh-cx__heading" id="{{ anchor }}-title">
                    {{- block.settings.heading | escape -}}
                    {%- if block.settings.heading_accent != blank -%}
                      {{- ' ' -}}
                      <span class="dlh-cx__heading-accent">{{ block.settings.heading_accent | escape }}</span>
                    {%- endif -%}
                  </h2>
                </div>
                {%- if block.settings.intro != blank -%}
                  <p class="dlh-cx__group-intro">{{ block.settings.intro | escape }}</p>
                {%- endif -%}
              </header>
          {%- endif -%}

        {%- when 'experience' -%}
          {%- liquid
            assign block_product = block.settings.product
            assign in_collection = false
            if block_product != blank
              assign needle = '|' | append: block_product.handle | append: '|'
              if coll_handles contains needle
                assign in_collection = true
              endif
            endif
          -%}
          {%- if in_collection -%}
            {%- liquid
              unless group_open
                echo '<section class="dlh-cx__group">'
                assign group_open = true
              endunless
              unless grid_open
                assign seg_c = seg_cards_list[seg] | plus: 0
                if seg_c > 4
                  assign seg_c = 3
                endif
                echo '<div class="dlh-cx__grid dlh-cx__grid--n' | append: seg_c | append: '">'
                assign grid_open = true
              endunless

              assign is_flagship = false
              if block_product.handle == flagship_handle
                assign is_flagship = true
              endif

              assign exp_name = block_product.title
              if is_flagship
                assign exp_name = flagship_name
              endif
              assign exp_price = block_product.price_min
              if block.settings.price_source == 'max'
                assign exp_price = block_product.price_max
              endif
              assign exp_highlights = block.settings.highlights | newline_to_br | strip_newlines | replace: '<br />', '|||'
            -%}

            {%- if is_flagship -%}
              <article class="dlh-cx__feature" {{ block.shopify_attributes }}>
                <div class="dlh-cx__feature-media">
                  {%- for i in (1..2) -%}
                    {%- liquid
                      if i == 1
                        assign photo = section.settings.flagship_image_1
                        assign photo_asset = section.settings.flagship_image_1_asset
                        assign photo_label = section.settings.flagship_image_1_label
                        if photo == blank and photo_asset == blank
                          assign photo = block_product.featured_image
                        endif
                      else
                        assign photo = section.settings.flagship_image_2
                        assign photo_asset = section.settings.flagship_image_2_asset
                        assign photo_label = section.settings.flagship_image_2_label
                      endif
                    -%}
                    {%- if photo != blank or photo_asset != blank -%}
                      <figure class="dlh-cx__feature-fig">
                        {%- if photo != blank -%}
                          {%- assign photo_alt = photo.alt | default: photo_label | default: exp_name | escape -%}
                          {{ photo | image_url: width: 1000 | image_tag: class: 'dlh-cx__feature-img', loading: 'lazy', widths: '360, 540, 720, 1000', sizes: '(min-width: 990px) 28vw, 50vw', alt: photo_alt }}
                        {%- else -%}
                          <img
                            class="dlh-cx__feature-img"
                            src="{{ photo_asset | asset_url }}"
                            alt="{{ photo_label | default: exp_name | escape }}"
                            width="1000"
                            height="1250"
                            loading="lazy"
                            decoding="async"
                          >
                        {%- endif -%}
                        {%- if photo_label != blank -%}
                          <figcaption class="dlh-cx__feature-label">{{ photo_label | escape }}</figcaption>
                        {%- endif -%}
                      </figure>
                    {%- endif -%}
                  {%- endfor -%}
                </div>

                <div class="dlh-cx__feature-body">
                  {%- if section.settings.flagship_badge != blank -%}
                    <span class="dlh-cx__feature-badge">{{ section.settings.flagship_badge | escape }}</span>
                  {%- endif -%}

                  {%- if block.settings.when != blank or block.settings.meta != blank -%}
                    <p class="dlh-cx__feature-meta">
                      {{- block.settings.when | escape -}}
                      {%- if block.settings.when != blank and block.settings.meta != blank %} · {% endif -%}
                      {{- block.settings.meta | escape -}}
                    </p>
                  {%- endif -%}

                  <h3 class="dlh-cx__feature-title">
                    <a href="{{ block_product.url }}" class="dlh-cx__feature-link">{{ exp_name | escape }}</a>
                  </h3>

                  {%- if section.settings.flagship_rating != blank -%}
                    <p class="dlh-cx__feature-rating">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                      </svg>
                      <b>{{ section.settings.flagship_rating | escape }}</b>
                      {%- if section.settings.flagship_review_count != blank -%}
                        <span>{{ section.settings.flagship_review_count | escape }}</span>
                      {%- endif -%}
                    </p>
                  {%- endif -%}

                  {%- if block.settings.tagline != blank -%}
                    <p class="dlh-cx__feature-tagline">{{ block.settings.tagline | escape }}</p>
                  {%- endif -%}

                  {%- assign feature_points = exp_highlights | split: '|||' -%}
                  {%- if feature_points.size > 0 -%}
                    <ul class="dlh-cx__feature-points" role="list">
                      {%- for point in feature_points -%}
                        {%- assign point_text = point | strip -%}
                        {%- if point_text != blank -%}
                          <li>
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                              <path d="M20 6L9 17l-5-5"/>
                            </svg>
                            {{ point_text | escape }}
                          </li>
                        {%- endif -%}
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}

                  <div class="dlh-cx__feature-footer">
                    <p class="dlh-cx__feature-price">
                      {%- if section.settings.price_prefix != blank -%}
                        <span class="dlh-cx__feature-price-label">{{ section.settings.price_prefix | escape }}</span>
                      {%- endif -%}
                      <span class="dlh-cx__feature-price-value">{{ exp_price | money_without_trailing_zeros }}</span>
                      {%- if block.settings.price_unit != blank -%}
                        <span class="dlh-cx__feature-price-unit">{{ block.settings.price_unit | escape }}</span>
                      {%- endif -%}
                    </p>
                    {%- if section.settings.flagship_cta_label != blank -%}
                      <span class="dlh-cx__feature-cta" aria-hidden="true">{{ section.settings.flagship_cta_label | escape }} <span>→</span></span>
                    {%- endif -%}
                  </div>

                  {%- if section.settings.flagship_note != blank -%}
                    <p class="dlh-cx__feature-note">{{ section.settings.flagship_note | escape }}</p>
                  {%- endif -%}
                </div>
              </article>
            {%- else -%}
              {%- liquid
                assign card_sizes = '(min-width: 1100px) 33vw, (min-width: 750px) 50vw, 100vw'
                if seg_c == 2 or seg_c == 1
                  assign card_sizes = '(min-width: 1100px) 22vw, (min-width: 750px) 50vw, 100vw'
                endif
              -%}
              {%- render 'dlh-collection-card',
                product: block_product,
                when: block.settings.when,
                meta: block.settings.meta,
                tagline: block.settings.tagline,
                highlights: exp_highlights,
                badge: block.settings.badge,
                price_prefix: section.settings.price_prefix,
                price_source: block.settings.price_source,
                price_unit: block.settings.price_unit,
                cta_label: section.settings.card_cta_label,
                sizes: card_sizes,
                attributes: block.shopify_attributes
              -%}
            {%- endif -%}

            {%- capture compare_row -%}
              <li>
                <a href="{{ block_product.url }}" class="dlh-cx__row{% if is_flagship %} dlh-cx__row--flagship{% endif %}">
                  <span class="dlh-cx__row-name">
                    {{- exp_name | escape -}}
                    {%- if is_flagship and section.settings.flagship_badge != blank -%}
                      <span class="dlh-cx__row-badge">{{ section.settings.flagship_badge | escape }}</span>
                    {%- endif -%}
                  </span>
                  <span class="dlh-cx__row-when">{{ block.settings.when | escape }}</span>
                  <span class="dlh-cx__row-for">{{ block.settings.best_for | escape }}</span>
                  <span class="dlh-cx__row-price">
                    {{ section.settings.price_prefix | escape }}
                    <b>{{ exp_price | money_without_trailing_zeros }}</b>
                    {{ block.settings.price_unit | escape }}
                  </span>
                  <span class="dlh-cx__row-arrow" aria-hidden="true">→</span>
                </a>
              </li>
            {%- endcapture -%}
            {%- assign compare_rows = compare_rows | append: compare_row -%}
          {%- endif -%}

        {%- when 'pointer' -%}
          {%- if flagship != blank -%}
            {%- liquid
              if grid_open
                echo '</div>'
                assign grid_open = false
              endif
              unless group_open
                echo '<section class="dlh-cx__group">'
                assign group_open = true
              endunless
            -%}
            <a href="{{ flagship.url }}" class="dlh-cx__pointer" {{ block.shopify_attributes }}>
              {%- if flagship_thumb != blank -%}
                <span class="dlh-cx__pointer-thumb">{{ flagship_thumb }}</span>
              {%- endif -%}
              <span class="dlh-cx__pointer-copy">
                {%- if block.settings.eyebrow != blank -%}
                  <span class="dlh-cx__pointer-eyebrow">{{ block.settings.eyebrow | escape }}</span>
                {%- endif -%}
                <span class="dlh-cx__pointer-text">{{ block.settings.text | escape }}</span>
              </span>
              <span class="dlh-cx__pointer-cta">
                <span class="dlh-cx__pointer-name">{{ flagship_name | escape }}</span>
                <span class="dlh-cx__pointer-price">
                  {{ section.settings.price_prefix | escape }}
                  {{ flagship_price | money_without_trailing_zeros }}
                  {{ section.settings.flagship_price_unit | escape }}
                </span>
              </span>
              <span class="dlh-cx__pointer-arrow" aria-hidden="true">→</span>
            </a>
          {%- endif -%}
      {%- endcase -%}
    {%- endfor -%}

    {%- liquid
      if grid_open
        echo '</div>'
      endif
      if group_open
        echo '</section>'
      endif
    -%}

    {%- comment -%} ---------- Collection products that have no block ---------- {%- endcomment -%}
    {%- if leftover_count > 0 -%}
      {%- liquid
        assign more_cols = leftover_count
        if more_cols > 4
          assign more_cols = 3
        endif
      -%}
      <section class="dlh-cx__group" id="more-experiences">
        {%- if section.settings.more_heading != blank and used_handles != '|' -%}
          <header class="dlh-cx__group-head">
            <div class="dlh-cx__group-title">
              <h2 class="dlh-cx__heading">{{ section.settings.more_heading | escape }}</h2>
            </div>
          </header>
        {%- endif -%}
        <div class="dlh-cx__grid dlh-cx__grid--n{{ more_cols }}">
          {%- for coll_product in collection.products -%}
            {%- assign needle = '|' | append: coll_product.handle | append: '|' -%}
            {%- unless used_handles contains needle -%}
              {%- render 'dlh-collection-card',
                product: coll_product,
                price_prefix: section.settings.price_prefix,
                cta_label: section.settings.card_cta_label
              -%}
              {%- capture compare_row -%}
                <li>
                  <a href="{{ coll_product.url }}" class="dlh-cx__row">
                    <span class="dlh-cx__row-name">{{ coll_product.title | escape }}</span>
                    <span class="dlh-cx__row-when"></span>
                    <span class="dlh-cx__row-for"></span>
                    <span class="dlh-cx__row-price">
                      {{ section.settings.price_prefix | escape }}
                      <b>{{ coll_product.price_min | money_without_trailing_zeros }}</b>
                    </span>
                    <span class="dlh-cx__row-arrow" aria-hidden="true">→</span>
                  </a>
                </li>
              {%- endcapture -%}
              {%- assign compare_rows = compare_rows | append: compare_row -%}
            {%- endunless -%}
          {%- endfor -%}
        </div>
      </section>
    {%- endif -%}

    {%- comment -%} ---------- At a glance ---------- {%- endcomment -%}
    {%- if section.settings.show_compare and compare_rows != blank -%}
      <section class="dlh-cx__group dlh-cx__compare" id="compare" aria-labelledby="compare-title">
        <header class="dlh-cx__group-head">
          <div class="dlh-cx__group-title">
            {%- if section.settings.compare_eyebrow != blank -%}
              <p class="dlh-cx__eyebrow">{{ section.settings.compare_eyebrow | escape }}</p>
            {%- endif -%}
            <h2 class="dlh-cx__heading" id="compare-title">
              {{- section.settings.compare_heading | escape -}}
              {%- if section.settings.compare_heading_accent != blank -%}
                {{- ' ' -}}
                <span class="dlh-cx__heading-accent">{{ section.settings.compare_heading_accent | escape }}</span>
              {%- endif -%}
            </h2>
          </div>
          {%- if section.settings.compare_intro != blank -%}
            <p class="dlh-cx__group-intro">{{ section.settings.compare_intro | escape }}</p>
          {%- endif -%}
        </header>

        <div class="dlh-cx__table">
          <div class="dlh-cx__table-head" aria-hidden="true">
            <span>{{ section.settings.compare_col_name | escape }}</span>
            <span>{{ section.settings.compare_col_when | escape }}</span>
            <span>{{ section.settings.compare_col_for | escape }}</span>
            <span>{{ section.settings.compare_col_price | escape }}</span>
            <span></span>
          </div>
          <ul class="dlh-cx__table-rows" role="list">
            {{ compare_rows }}
          </ul>
        </div>
      </section>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Collection experiences",
  "tag": "div",
  "class": "section-wrapper",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the products of the current collection as groups. Add a Group block, then the Experience blocks that belong to it. Products of the collection without a block are listed at the end."
    },
    {
      "type": "header",
      "content": "Signature experience"
    },
    {
      "type": "product",
      "id": "flagship_product",
      "label": "Product",
      "info": "Its Experience block becomes the large feature, and the pointer strips link to it."
    },
    {
      "type": "text",
      "id": "flagship_name",
      "label": "Display name",
      "info": "Leave empty to use the product title."
    },
    {
      "type": "text",
      "id": "flagship_badge",
      "label": "Badge",
      "default": "Our signature experience"
    },
    {
      "type": "text",
      "id": "flagship_rating",
      "label": "Rating",
      "default": "4.9"
    },
    {
      "type": "text",
      "id": "flagship_review_count",
      "label": "Review count",
      "default": "1,247 verified reviews"
    },
    {
      "type": "select",
      "id": "flagship_price_source",
      "label": "Price shown in the pointer strips",
      "options": [
        { "value": "min", "label": "Lowest variant price" },
        { "value": "max", "label": "Highest variant price (e.g. adult)" }
      ],
      "default": "max"
    },
    {
      "type": "text",
      "id": "flagship_price_unit",
      "label": "Price unit in the pointer strips",
      "default": "per adult"
    },
    {
      "type": "text",
      "id": "flagship_cta_label",
      "label": "Button label",
      "default": "View this experience"
    },
    {
      "type": "text",
      "id": "flagship_note",
      "label": "Note under the price",
      "default": "Child price for ages 3-10 · Taxes & fees included"
    },
    {
      "type": "image_picker",
      "id": "flagship_image_1",
      "label": "Photo 1"
    },
    {
      "type": "text",
      "id": "flagship_image_1_asset",
      "label": "Photo 1 (theme asset file name)",
      "info": "Used when no photo 1 is selected.",
      "default": "dlh-safari-sunset.webp"
    },
    {
      "type": "text",
      "id": "flagship_image_1_label",
      "label": "Photo 1 label",
      "default": "Sunset"
    },
    {
      "type": "image_picker",
      "id": "flagship_image_2",
      "label": "Photo 2"
    },
    {
      "type": "text",
      "id": "flagship_image_2_asset",
      "label": "Photo 2 (theme asset file name)",
      "info": "Used when no photo 2 is selected.",
      "default": "dlh-safari-starlight.webp"
    },
    {
      "type": "text",
      "id": "flagship_image_2_label",
      "label": "Photo 2 label",
      "default": "Starlight"
    },
    {
      "type": "header",
      "content": "Labels"
    },
    {
      "type": "text",
      "id": "nav_label",
      "label": "Jump links label",
      "default": "Jump to"
    },
    {
      "type": "text",
      "id": "price_prefix",
      "label": "Price prefix",
      "default": "From"
    },
    {
      "type": "text",
      "id": "card_cta_label",
      "label": "Card link label",
      "default": "Explore"
    },
    {
      "type": "text",
      "id": "more_heading",
      "label": "Heading for products without a block",
      "default": "More experiences"
    },
