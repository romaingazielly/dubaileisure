{{ 'dlh-usp-ticker.css' | asset_url | stylesheet_tag }}

<section
  class="dlh-usp-ticker"
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% if section.settings.speed > 0 %}--ticker-speed: {{ section.settings.speed }}s;{% endif %}
  "
  aria-label="{{ section.settings.aria_label | default: 'Why travel with us' }}"
  {{ section.shopify_attributes }}
>
  <div class="dlh-usp-ticker__track">
    <div class="dlh-usp-ticker__row">
      {%- comment -%} Render items twice for seamless infinite loop {%- endcomment -%}
      {%- for pass in (1..2) -%}
        {%- for block in section.blocks -%}
          <div class="dlh-usp-ticker__item" {{ block.shopify_attributes }}>
            <div class="dlh-usp-ticker__icon" aria-hidden="true">
              {%- liquid
                assign icon = block.settings.icon_type
                assign svg_attrs = 'viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" focusable="false"'
              -%}
              {%- case icon -%}
                {%- when 'star' -%}
                  <svg {{ svg_attrs }}><path d="M12 3.2l2.7 5.5 6.1.9-4.4 4.3 1 6-5.4-2.9-5.4 2.9 1-6-4.4-4.3 6.1-.9z" fill="currentColor"/></svg>
                {%- when 'quote' -%}
                  <svg {{ svg_attrs }}><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><path d="M13 8H7"/><path d="M17 12H7"/></svg>
                {%- when 'award' -%}
                  <svg {{ svg_attrs }}><circle cx="12" cy="8" r="6"/><path d="m15.48 12.89 1.51 8.53a.5.5 0 0 1-.81.47l-3.58-2.69a1 1 0 0 0-1.2 0l-3.58 2.69a.5.5 0 0 1-.81-.47l1.51-8.53"/></svg>
                {%- when 'heritage' -%}
                  <svg {{ svg_attrs }}><path d="M12 3v1.5"/><path d="M5.6 5.6l1.1 1.1"/><path d="M18.4 5.6l-1.1 1.1"/><path d="M8 12a4 4 0 0 1 8 0"/><path d="M2 20c2.5-.5 4.5-2.5 6.5-5 1.5-1.9 3-3 4.5-3 3 0 4 4 6.5 6 .8.7 1.6 1.2 2.5 2z"/></svg>
                {%- when 'camp' -%}
                  <svg {{ svg_attrs }}><path d="M12 5 3 20h18z"/><path d="M12 12.5 9.5 20"/><path d="M12 12.5l2.5 7.5"/><path d="M12 5V2.5"/><path d="M12 2.5l3 1-3 1"/></svg>
                {%- when 'shield' -%}
                  <svg {{ svg_attrs }}><path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"/><path d="m9 12 2 2 4-4"/></svg>
                {%- when 'insured' -%}
                  <svg {{ svg_attrs }}><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
                {%- when 'pickup' -%}
                  <svg {{ svg_attrs }}><path d="M4.25 17.5H3a1 1 0 0 1-1-1v-8a1 1 0 0 1 1-1h10.2a1 1 0 0 1 .8.4l2.6 3.6 4.3.9a1.4 1.4 0 0 1 1.1 1.4v2.7a1 1 0 0 1-1 1h-1.25"/><path d="M8.75 17.5h6.5"/><path d="M2 11.5h14.6"/><path d="M8.5 7.5v4"/><circle cx="6.5" cy="17.5" r="2.25"/><circle cx="17.5" cy="17.5" r="2.25"/><path d="M4.5 5h7.5"/><path d="M6 5v2.5"/><path d="M10.5 5v2.5"/></svg>
                {%- when 'cancel' -%}
                  <svg {{ svg_attrs }}><path d="M8 2v4"/><path d="M16 2v4"/><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M3 10h18"/><path d="m14.5 13.5-5 5"/><path d="m9.5 13.5 5 5"/></svg>
                {%- when 'instant' -%}
                  <svg {{ svg_attrs }}><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/></svg>
                {%- when 'paylater' -%}
                  <svg {{ svg_attrs }}><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/><path d="M6 15h4"/></svg>
                {%- when 'guide' -%}
                  <svg {{ svg_attrs }}><circle cx="12" cy="12" r="10"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="M16.8 7.2 14 14l-4-4z" fill="currentColor" stroke-width="1"/><path d="M7.2 16.8 10 10l4 4z" stroke-width="1.1"/></svg>
                {%- when 'group' -%}
                  <svg {{ svg_attrs }}><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                {%- when 'private' -%}
                  <svg {{ svg_attrs }}><path d="M11.56 3.27a.5.5 0 0 1 .88 0l2.95 5.6a1 1 0 0 0 1.52.3l4.27-3.67a.5.5 0 0 1 .8.52l-2.83 10.25a1 1 0 0 1-.96.73H5.81a1 1 0 0 1-.96-.73L2.02 6.02a.5.5 0 0 1 .8-.52l4.27 3.67a1 1 0 0 0 1.52-.3z"/><path d="M5 21h14"/></svg>
                {%- when 'whatsapp' -%}
                  <svg viewBox="0 0 32 32" fill="currentColor" focusable="false"><path d="M26.576 5.363c-2.69-2.69-6.406-4.354-10.511-4.354-8.209 0-14.865 6.655-14.865 14.865 0 2.732 0.737 5.291 2.022 7.491l-0.038-0.070-2.109 7.702 7.879-2.067c2.051 1.139 4.498 1.809 7.102 1.809h0.006c8.209-0.003 14.862-6.659 14.862-14.868 0-4.103-1.662-7.817-4.349-10.507l0 0zM16.062 28.228h-0.005c-0 0-0.001 0-0.001 0-2.319 0-4.489-0.64-6.342-1.753l0.056 0.031-0.451-0.267-4.675 1.227 1.247-4.559-0.294-0.467c-1.185-1.862-1.889-4.131-1.889-6.565 0-6.822 5.531-12.353 12.353-12.353s12.353 5.531 12.353 12.353c0 6.822-5.53 12.353-12.353 12.353h-0zM22.838 18.977c-0.371-0.186-2.197-1.083-2.537-1.208-0.341-0.124-0.589-0.185-0.837 0.187-0.246 0.371-0.958 1.207-1.175 1.455-0.216 0.249-0.434 0.279-0.805 0.094-1.15-0.466-2.138-1.087-2.997-1.852l0.010 0.009c-0.799-0.74-1.484-1.587-2.037-2.521l-0.028-0.052c-0.216-0.371-0.023-0.572 0.162-0.757 0.167-0.166 0.372-0.434 0.557-0.65 0.146-0.179 0.271-0.384 0.366-0.604l0.006-0.017c0.043-0.087 0.068-0.188 0.068-0.296 0-0.131-0.037-0.253-0.101-0.357l0.002 0.003c-0.094-0.186-0.836-2.014-1.145-2.758-0.302-0.724-0.609-0.625-0.836-0.637-0.216-0.010-0.464-0.012-0.712-0.012-0.395 0.010-0.746 0.188-0.988 0.463l-0.001 0.002c-0.802 0.761-1.3 1.834-1.3 3.023 0 0.026 0 0.053 0.001 0.079l-0-0.004c0.131 1.467 0.681 2.784 1.527 3.857l-0.012-0.015c1.604 2.379 3.742 4.282 6.251 5.564l0.094 0.043c0.548 0.248 1.25 0.513 1.968 0.74l0.149 0.041c0.442 0.14 0.951 0.221 1.479 0.221 0.303 0 0.601-0.027 0.889-0.078l-0.031 0.004c1.069-0.223 1.956-0.868 2.497-1.749l0.009-0.017c0.165-0.366 0.261-0.793 0.261-1.242 0-0.185-0.016-0.366-0.047-0.542l0.003 0.019c-0.092-0.155-0.34-0.247-0.712-0.434z"/></svg>
              {%- endcase -%}
            </div>

            <div class="dlh-usp-ticker__value">
              {%- if block.settings.number != blank -%}
                <div>
                  <span class="dlh-usp-ticker__num">{{ block.settings.number }}</span>
                  {%- if block.settings.unit != blank -%}
                    <span class="dlh-usp-ticker__unit">{{ block.settings.unit }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%}
              <div class="dlh-usp-ticker__label">{{ block.settings.label }}</div>
            </div>

            <span class="dlh-usp-ticker__sep" aria-hidden="true">✦</span>
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "USP Ticker",
  "tag": "div",
  "class": "section-wrapper",
  "max_blocks": 12,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "label": "Vitesse du défilement",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "s",
      "default": 50,
      "info": "Durée d'un cycle complet (plus élevé = plus lent)."
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Aria label (accessibilité)",
      "default": "Why travel with us"
    },
    {
      "type": "header",
      "content": "Espacements"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding haut",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bas",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "usp_item",
      "name": "USP",
      "settings": [
        {
          "type": "select",
          "id": "icon_type",
          "label": "Icône",
          "options": [
            { "value": "star", "label": "Étoile (note)" },
            { "value": "quote", "label": "Bulle (avis)" },
            { "value": "award", "label": "Médaille (award)" },
            { "value": "heritage", "label": "Soleil sur dune (héritage)" },
            { "value": "camp", "label": "Tente (camp)" },
            { "value": "shield", "label": "Badge validé (licence)" },
            { "value": "insured", "label": "Bouclier validé (assurance)" },
            { "value": "pickup", "label": "4x4 (pickup)" },
            { "value": "cancel", "label": "Calendrier barré (annulation)" },
            { "value": "instant", "label": "Éclair (confirmation instantanée)" },
            { "value": "paylater", "label": "Carte (paiement différé)" },
            { "value": "guide", "label": "Boussole (guide)" },
            { "value": "group", "label": "Groupe (personnes)" },
            { "value": "private", "label": "Couronne (privé / VIP)" },
            { "value": "whatsapp", "label": "Bulle téléphone (WhatsApp)" }
          ],
          "default": "star"
        },
        {
          "type": "text",
          "id": "number",
          "label": "Chiffre / valeur",
          "default": "4.9"
        },
        {
          "type": "text",
          "id": "unit",
          "label": "Unité (optionnel)",
          "default": "/5",
          "info": "Ex: /5, yrs, h…"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Libellé",
          "default": "Guest rating"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "USP Ticker",
      "category": "t:categories.storytelling",
      "blocks": [
        {
          "type": "usp_item",
          "settings": {
            "icon_type": "star",
            "number": "4.9",
            "unit": "/5",
            "label": "TripAdvisor · 1,250+ reviews"
          }
        },
        {
          "type": "usp_item",
          "settings": {
            "icon_type": "heritage",
            "number": "Since 2004",
            "unit": "",
            "label": "Dubai desert specialists"
          }
        },
        {
          "type": "usp_item",
          "settings": {
            "icon_type": "pickup",
            "number": "Free",
            "unit": "",
            "label": "4x4 hotel pickup & drop-off"
          }
        },
        {
          "type": "usp_item",
          "settings": {
            "icon_type": "shield",
            "number": "DET",
            "unit": "",
            "label": "Licensed & insured operator"
          }
        },
        {
          "type": "usp_item",
          "settings": {
            "icon_type": "guide",
            "number": "Experienced",
            "unit": "",
            "label": "Desert safari guides"
          }
        },
        {
          "type": "usp_item",
          "settings": {
            "icon_type": "cancel",
            "number": "Free",
            "unit": "",
            "label": "Cancellation up to 24h before"
          }
        },
        {
          "type": "usp_item",
          "settings": {
            "icon_type": "whatsapp",
            "number": "24/7",
            "unit": "",
            "label": "WhatsApp concierge"
          }
        }
      ]
    }
  ]
}
{% endschema %}
