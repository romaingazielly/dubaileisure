{% schema %}
{
  "name": "USP Ticker",
  "tag": "div",
  "class": "section-wrapper",
  "max_blocks": 12,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "label": "Vitesse du défilement",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "s",
      "default": 50,
      "info": "Durée d'un cycle complet (plus élevé = plus lent)."
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Aria label (accessibilité)",
      "default": "Why travel with us"
    },
    {
      "type": "header",
      "content": "Espacements"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding haut",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 0
    },
