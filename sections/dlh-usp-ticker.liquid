{{ 'dlh-usp-ticker.css' | asset_url | stylesheet_tag }}

<section
  class="dlh-usp-ticker"
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% if section.settings.speed > 0 %}--ticker-speed: {{ section.settings.speed }}s;{% endif %}
  "
  aria-label="{{ section.settings.aria_label | default: 'Why travel with us' }}"
  {{ section.shopify_attributes }}
>
  <div class="dlh-usp-ticker__track">
    <div class="dlh-usp-ticker__row">
      {%- comment -%} Render items twice for seamless infinite loop {%- endcomment -%}
      {%- for pass in (1..2) -%}
        {%- for block in section.blocks -%}
          <div class="dlh-usp-ticker__item" {{ block.shopify_attributes }}>
            <div class="dlh-usp-ticker__icon">
              {%- liquid
                assign icon = block.settings.icon_type
              -%}
              {%- case icon -%}
                {%- when 'star' -%}
                  <svg viewBox="0 0 32 32" fill="none" stroke="var(--brand-red-bright, #c41e3a)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 3.5l3.7 7.9 8.3 1-6.2 6 1.6 8.6L16 22.8 8.6 27l1.6-8.6L4 12.4l8.3-1L16 3.5z" fill="var(--brand-red-bright, #c41e3a)" fill-opacity="0.12"/></svg>
                {%- when 'quote' -%}
                  <svg viewBox="0 0 32 32" fill="none" stroke="var(--brand-red-bright, #c41e3a)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 17V13a3 3 0 0 1 3-3"/><path d="M13 17V13a3 3 0 0 1 3-3"/><path d="M2 17h6M10 17h6"/><circle cx="24" cy="21" r="5"/><path d="M21.5 21l2 2 3-3.5"/></svg>
                {%- when 'heritage' -%}
                  <svg viewBox="0 0 32 32" fill="none" stroke="var(--brand-red-bright, #c41e3a)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 27V14l12-8 12 8v13"/><path d="M11 27v-7h10v7"/><path d="M4 27h24"/></svg>
                {%- when 'shield' -%}
