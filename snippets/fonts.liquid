{% # theme-check-disable %}
{%- unless settings.type_body_font.system? -%}
  <link
    rel="preload"
    as="font"
    href="{{ settings.type_body_font | font_url }}"
    type="font/woff2"
    crossorigin
    fetchpriority="low"
  >
{%- endunless -%}
{%- comment -%}
  Heading + subheading fonts are intentionally not preloaded here:
  Kufam (self-hosted) replaces them via assets/dlh-typography.css.liquid, and is
  preloaded directly from layout/theme.liquid. Preloading the Shopify-selected
  font would download an unused file.
{%- endcomment -%}
{%- unless settings.type_accent_font.system? -%}
  <link
    rel="preload"
    as="font"
    href="{{ settings.type_accent_font | font_url }}"
    type="font/woff2"
    crossorigin
    fetchpriority="low"
  >
{%- endunless -%}
{% # theme-check-enable %}
